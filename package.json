{
  "name": "agent-remote",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Local-first Apple control plane for coding agents running on a Mac",
  "workspaces": [
    "protocol/typescript",
    "bridge",
    "providers/claude"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run typecheck && bun test",
    "dev": "bun run --cwd bridge dev",
    "bridge": "bun run --cwd bridge cli"
  }
}
